      "summary": "Read and send mail for one Gmail or Google Workspace mailbox with an OAuth refresh token: list messages with a Gmail search query, and send from the mailbox's address.",
      "title": "Gmail",
      "tools": [
        {
          "description": "List messages in the mailbox that match a Gmail search query (for example\n\"is:unread from:billing@example.com newer_than:7d\"): sender, recipients, subject, a\nshort snippet, labels and attachment names, newest first. Use next_page_token to\ncontinue.",
          "idempotency": "idempotent",
          "input_schema": {
            "additionalProperties": false,
            "properties": {
              "max_results": {
                "default": 25,
                "maximum": 100,
                "minimum": 1,
                "type": "integer"
              },
              "page_token": {
                "anyOf": [
                  {
                    "maxLength": 2000,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "query": {
                "default": "is:unread",
                "maxLength": 500,
                "type": "string"
              }
            },
            "type": "object"
          },
          "max_attempts": 3,
          "name": "gmail.list_messages",
          "output_schema": {
            "additionalProperties": false,
            "properties": {
              "messages": {
                "default": [],
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "attachments": {
                      "default": [],
                      "items": {
                        "additionalProperties": false,
                        "description": "Bounded Gmail attachment descriptor; bytes are fetched only on explicit demand.",
                        "properties": {
                          "filename": {
                            "maxLength": 255,
                            "minLength": 1,
                            "type": "string"
                          },
                          "media_type": {
                            "default": "application/octet-stream",
                            "maxLength": 255,
                            "minLength": 3,
                            "type": "string"
                          },
                          "provider_attachment_id": {
                            "maxLength": 2000,
                            "minLength": 1,
                            "type": "string"
                          },
                          "size": {
                            "default": 0,
                            "minimum": 0,
                            "type": "integer"
                          }
                        },
                        "required": [
                          "provider_attachment_id",
                          "filename"
                        ],
                        "type": "object"
                      },
                      "type": "array"
                    },
                    "labels": {
                      "default": [],
                      "items": {
                        "type": "string"
                      },
                      "type": "array"
                    },
                    "provider_message_id": {
                      "type": "string"
                    },
                    "received_at_ms": {
                      "default": 0,
                      "minimum": 0,
                      "type": "integer"
                    },
                    "recipients": {
                      "default": "",
                      "type": "string"
                    },
                    "sender": {
                      "default": "",
                      "type": "string"
                    },
                    "snippet": {
                      "default": "",
                      "maxLength": 2000,
                      "type": "string"
                    },
                    "subject": {
                      "default": "",
                      "type": "string"
                    },
                    "thread_id": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ],
                      "default": null
                    }
                  },
                  "required": [
                    "provider_message_id"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "next_page_token": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null
              },
              "result_size_estimate": {
                "default": 0,
                "minimum": 0,
                "type": "integer"
              }
            },
            "type": "object"
          },
